{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        "balance": {
          ".write": false
        },

        "inventory": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },

        "stats": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },

    "upgrades": {
      // Читать могут все авторизованные
      ".read": "auth !== null",
      "$upgradeId": {
        ".write": "auth !== null && (data.child('uid').val() === auth.uid || !data.exists())"
      }
    },

    "admin_logs": {
      ".read": "auth !== null",
      ".write": "auth !== null"
    }
  }
}
