{
  "rules": {
    "users": {
      ".read": "auth !== null",
      ".indexOn": ["nickname"],
      "$uid": {
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "balance": {
          ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "inventory": {
          ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "stats": {
          ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "upgrades": {
      ".read": "auth !== null",
      ".indexOn": [
        "uid",
        "createdAt"
      ],
      "$upgradeId": {
        ".write": "auth !== null && (!data.exists() || newData.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "liveDrops": {
      ".read": "auth !== null",
      ".indexOn": [
        "createdAt",
        "uid"
      ],
      "$dropId": {
        ".write": "auth !== null"
      }
    },
    "meta": {
      ".read": "auth !== null",
      ".write": "auth !== null"
    },
    "admin_logs": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "presence": {
      ".read": "auth !== null",
      "$uid": {
        ".write": "auth !== null && $uid === auth.uid"
      }
    }
  }
}